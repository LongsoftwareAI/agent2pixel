# Localhost only. Copy to .env; never commit credentials.
# MockBrain works without any key/model.
AGENTVERSE_DATA_DIR=var
AGENTVERSE_OPENAI_API_KEY=
AGENTVERSE_DEEPSEEK_API_KEY=
# For Harness choose secret_ref=AGENTVERSE_DEEPSEEK_API_KEY in Agent Studio.
# Provider endpoint allowlist is configured server-side, never by arbitrary browser URLs.
# Comma-separated HTTPS hosts permitted for OpenAI-compatible providers.
AGENTVERSE_PROVIDER_HOSTS=api.openai.com,api.deepseek.com
# Ollama defaults to http://127.0.0.1:11434 (must be installed separately).

# Optional exact source-reader HTTPS host allowlist. Defaults shown; no queries/credentials/private addresses.
# AGENTVERSE_WEB_ALLOWED_HOSTS=en.wikipedia.org,vi.wikipedia.org,www.python.org,docs.python.org,raw.githubusercontent.com
