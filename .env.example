# Localhost only. Copy to .env; never commit credentials.
# MockBrain works without any key/model.
AGENTVERSE_DATA_DIR=var
AGENTVERSE_OPENAI_API_KEY=
# Provider endpoint allowlist is configured server-side, never by arbitrary browser URLs.
# Comma-separated HTTPS hosts permitted for OpenAI-compatible providers.
AGENTVERSE_PROVIDER_HOSTS=api.openai.com
# Ollama defaults to http://127.0.0.1:11434 (must be installed separately).
